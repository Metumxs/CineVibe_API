{

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://example.com",
      "https://www.example.com"
    ]
  },

  "AppSettings": {
    "FrontendBaseUrl": "http://localhost:3000",
    "PasswordResetTokenExpirationMinutes": 60
  },

  "JwtSettings": {
    "Issuer": "CineVibeAPI",
    "Audience": "CineVibeClient",
    "TokenExpirationHours": 2
  },

  "MongoDB": {
    "DatabaseName": "CineVibeDB",
    "UsersCollectionName": "Users",
    "MoviePreviewsCollectionName": "MoviePreviewsCache",
    "PasswordResetTokensCollectionName": "PasswordResetTokens"
  },

  "TmdbSettings": {
    "BaseUrl": "https://api.themoviedb.org/3/",
    "PosterImageBaseUrl": "https://image.tmdb.org/t/p/w500",
    "BackdropImageBaseUrl": "https://image.tmdb.org/t/p/w1280"
  },

  "SendGrid": {
    "SenderEmail": "noreply@example.com",
    "SenderName": "CineVibe"
  },

  "CacheSettings": {
    "MovieCatalogPreviewsCacheDurationHours": 24,
    "MovieOpportunisticPreviewsCacheDurationHours": 24
  }
}
